  "findings": [
    {
      "area": "impact articulation",
      "result": "pass",
      "observation": "Body impacts fold the torso and bend knees with arms toward the abdomen. Head impacts snap the head and shoulders backward, then move a hand toward the face. Sweep visibly buckles the leg. The first impact samples already show the appropriate reaction drawing."
    },
    {
      "area": "guard articulation",
      "result": "pass",
      "observation": "Standing, overhead and projectile guard samples use crossed raised arms followed by a different guarded stance. Low guard lowers the body and braces the arms over a bent knee. Ground contact stays readable in both the immediate absorption and later samples."
    },
    {
      "area": "airborne reactions",
      "result": "pass",
      "observation": "AntiAir, Throw, SignatureSpecial and both cinematic launch windows show a complete airborne silhouette with changing torso and leg articulation. No body clipping at the sprite cell boundary was visible in inspected frames."
    },
    {
      "area": "ground impact and rise",
      "result": "pass",
      "observation": "Fall samples visibly place the body on its side at floor level. Rise samples progress through forearm/hand and knee support, then the age14 sample is standing with bent knees. Recovered samples restore the prior idle or guard at the same floor level."
    },
    {
      "area": "scale and pivots",
      "result": "pass",
      "observation": "Extended anatomy remains credible beside C++ and beside Python's restored base pose. Crouched, curled and kneeling drawings are shorter because of articulation. Feet, hands, knees and side-contact points stay aligned with the ground in inspected grounded states; no conspicuous floor float or sinking was seen."
    },
    {
      "area": "cinematic barrage",
      "result": "pass_for_sampled_contacts",
      "observation": "Sampled Head reactions at ticks 374, 384, 424 and 444, plus age7 after tick384, keep the head and upper torso readable as receiving the barrage. The earlier belly-fold silhouette that read as ducking under the high kick is absent from these samples."
    },
    {
      "area": "identity and compositing",
      "result": "pass",
      "observation": "Dark hair, white blouse, black skirt/skort, black shoes and blue/yellow belt accents remain recognizable. Actual game compositing shows clean silhouettes without a visible rectangular background or alpha halo in reviewed screenshots."
    },
    {
      "area": "throw facing",
      "result": "observed",
      "observation": "After the throw switches sides, reaction/rise maintains its earlier orientation; the recovered guard turns to face C++. This is an observed engine transition, not a Python alpha or pivot defect."
    }
  ],
