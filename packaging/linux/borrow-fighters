#!/bin/sh
# Resolve the portable root without relying on the caller's current directory.
set -eu
bundle_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LD_LIBRARY_PATH="$bundle_dir/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -f "$bundle_dir/share/alsa/alsa.conf" ]; then
    export ALSA_CONFIG_DIR="$bundle_dir/share/alsa"
fi
exec "$bundle_dir/bin/borrow-fighters" "$@"
